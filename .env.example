# =============================================================================
# CHIBOY TECHNOLOGIES — environment variables
# =============================================================================
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored and
# must never be committed. This file must contain variable NAMES and comments
# only — never real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase / any PostgreSQL)
# -----------------------------------------------------------------------------
# Runtime connection string. On serverless hosts this MUST be a *pooled*
# connection, otherwise the database exhausts connections under load.
DATABASE_URL="[pooled PostgreSQL connection string, e.g. Supabase POSTGRES_PRISMA_URL]"

# Direct (non-pooled) connection, used by the Prisma CLI for migrations and
# schema pushes. Migrations through a transaction pooler frequently fail.
DIRECT_URL="[direct PostgreSQL connection string, e.g. postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require]"

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Public origin used for canonical URLs, Open Graph tags and sitemap.xml.
# No trailing slash. Must be the real production domain in production.
NEXT_PUBLIC_SITE_URL="https://[your-domain]"

# -----------------------------------------------------------------------------
# Business contact details
# -----------------------------------------------------------------------------
# Supplied by the business and set in `.env.local`. Values here are examples
# only. Where a value is still a placeholder, the UI labels it visibly rather
# than presenting it as fact — see `isPlaceholder` in src/lib/env.ts.
#
# Phone: display form, including the international prefix.
NEXT_PUBLIC_PHONE_NUMBER="[business phone number, e.g. +2348000000000]"
# WhatsApp: accepts the same display form. Digits are extracted before the
# wa.me link is built, so "+" and spacing are for display only.
NEXT_PUBLIC_WHATSAPP_NUMBER="[WhatsApp number, e.g. +2348000000000]"
NEXT_PUBLIC_BUSINESS_EMAIL="[business email address]"
# Used for the footer contact block and the maps link. Service AREA is separate
# and is not yet confirmed; see the placeholder in the structured data.
NEXT_PUBLIC_BUSINESS_LOCATION="[business address]"
NEXT_PUBLIC_BUSINESS_HOURS="[business hours, e.g. Monday to Friday, 08:00 - 18:00]"
# OPTIONAL and currently unset. The geographic area served — NOT the office
# address. Leaving this empty makes the site emit no `areaServed` claim at all,
# which is correct while the coverage area is unconfirmed. Note that
# NEXT_PUBLIC_BUSINESS_HOURS is a display string: it is parsed into ISO 8601 for
# structured data, and an unparseable value is omitted rather than guessed at.
NEXT_PUBLIC_SERVICE_AREA=""

# -----------------------------------------------------------------------------
# Form notifications
# -----------------------------------------------------------------------------
# Both channels are optional and independent. With neither configured the site
# still works — a submission is saved to the database and a warning is logged —
# but nobody is told. A request that is stored and never seen is the failure mode
# to watch for, so check the logs after configuring.

# The address new service requests are notified to — the business owner's inbox.
# Replaces the earlier `CONTACT_NOTIFICATION_EMAIL`, which was declared but never
# read. One name for one destination.
OWNER_EMAIL="[inbox that should receive form submissions]"

# The address customers are told to contact, and the reply-to on the
# confirmation email the visitor receives. Also where the internal service
# request notification is delivered when this is set. Falls back to
# support@chiboytechnologies.com when it is empty, so replies are never lost —
# leaving it blank is safe rather than broken.
SUPPORT_EMAIL="support@chiboytechnologies.com"

# --- Channel 1: email, via Resend ---
# From https://resend.com/api-keys. Starts with `re_`. If unset, no email is sent.
RESEND_API_KEY=""

# The full From header. Preferred over RESEND_FROM_DOMAIN when set, because it is
# the only input that can carry a display name:
#   EMAIL_FROM="Chiboy Technologies <noreply@chiboytechnologies.com>"
# The local part must be on a domain verified in Resend, or delivery fails.
# Falls back to `RESEND_FROM_DOMAIN`, and then to Resend's onboarding address,
# so leaving it empty is safe rather than broken.
EMAIL_FROM="Chiboy Technologies <noreply@chiboytechnologies.com>"

# The verified domain to send from. Optional: Resend's onboarding domain only
# delivers to the address on the Resend account, which is sufficient here because
# these notifications go to the owner. A verified domain is only needed to send to
# any other recipient. Ignored when EMAIL_FROM is set.
RESEND_FROM_DOMAIN=""

# --- Channel 2: WhatsApp, via CallMeBot ---
# One-time setup, and it is easy to miss: the OWNER'S PHONE must send the
# activation message to the CallMeBot number before the first relay is accepted.
# Until that is done every call returns HTTP 200 with a body saying the number is
# not activated — the failure is reported in the body, not the status code.
#
# Get the API key by texting the activation message to +34 644 44 21 48 from the
# receiving number, or via https://www.callmebot.com/whatsapp.php
CALLMEBOT_PHONE=""
CALLMEBOT_APIKEY=""

# -----------------------------------------------------------------------------
# Rate limiting (Upstash Redis REST — no SDK dependency required)
# -----------------------------------------------------------------------------
# Optional in local development: the limiter falls back to an in-memory
# window so the app runs with no external service. Production rate limiting
# across serverless instances REQUIRES these to be set.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# File uploads (Vercel Blob)
# -----------------------------------------------------------------------------
# Images on the service request form are uploaded straight from the browser to
# Vercel Blob — not through an API route, because a Server Action or route body
# is capped at about 4.5 MB and a few phone photos would blow straight through
# it. The client exchanges a short-lived, per-file token for the right to upload
# one image of one type under one path, and the URLs come back for the form to
# submit with the rest of the answers.
#
# REQUIRED for image uploads. Vercel sets this automatically once a Blob store is
# connected to the project (Storage tab → connect). Until it is set the form
# accepts photos but every upload is refused with a 503.
BLOB_READ_WRITE_TOKEN=""

# The image rules are NOT configurable: five images, 5 MB each, JPG/PNG/WEBP,
# declared in one place and enforced on the client, in the issued token, and on
# the returned URLs. See src/lib/validation/images.ts.
#
# Legacy, for the local-disk attachment path the form no longer uses. The schema
# caps MAX_UPLOAD_MB at 4, so do not raise it above 4 — see `serverEnvSchema`.

# Directory for user-uploaded files. Intentionally outside `public/` so uploads
# are never served as static assets. NOTE: this filesystem is ephemeral on
# serverless hosts — see README "File storage" before going live.
UPLOAD_DIR="private-uploads"

# Maximum accepted upload size in megabytes. Keep this at or below 4 MB, which
# is the Vercel Server Action request body limit.
MAX_UPLOAD_MB="4"
