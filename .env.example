# =============================================================================
# CHIBOY TECHNOLOGIES — environment variables
# =============================================================================
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored and
# must never be committed. This file must contain variable NAMES and comments
# only — never real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase / any PostgreSQL)
# -----------------------------------------------------------------------------
# Runtime connection string. On serverless hosts this MUST be a *pooled*
# connection, otherwise the database exhausts connections under load.
DATABASE_URL="[pooled PostgreSQL connection string, e.g. Supabase POSTGRES_PRISMA_URL]"

# Direct (non-pooled) connection, used by the Prisma CLI for migrations and
# schema pushes. Migrations through a transaction pooler frequently fail.
DIRECT_URL="[direct PostgreSQL connection string, e.g. postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require]"

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Public origin used for canonical URLs, Open Graph tags and sitemap.xml.
# No trailing slash. Must be the real production domain in production.
NEXT_PUBLIC_SITE_URL="https://[your-domain]"

# -----------------------------------------------------------------------------
# Business contact details
# -----------------------------------------------------------------------------
# Supplied by the business and set in `.env.local`. Values here are examples
# only. Where a value is still a placeholder, the UI labels it visibly rather
# than presenting it as fact — see `isPlaceholder` in src/lib/env.ts.
#
# Phone: display form, including the international prefix.
NEXT_PUBLIC_PHONE_NUMBER="[business phone number, e.g. +2348000000000]"
# WhatsApp: accepts the same display form. Digits are extracted before the
# wa.me link is built, so "+" and spacing are for display only.
NEXT_PUBLIC_WHATSAPP_NUMBER="[WhatsApp number, e.g. +2348000000000]"
NEXT_PUBLIC_BUSINESS_EMAIL="[business email address]"
# Used for the footer contact block and the maps link. Service AREA is separate
# and is not yet confirmed; see the placeholder in the structured data.
NEXT_PUBLIC_BUSINESS_LOCATION="[business address]"
NEXT_PUBLIC_BUSINESS_HOURS="[business hours, e.g. Monday to Friday, 08:00 - 18:00]"
# OPTIONAL and currently unset. The geographic area served — NOT the office
# address. Leaving this empty makes the site emit no `areaServed` claim at all,
# which is correct while the coverage area is unconfirmed. Note that
# NEXT_PUBLIC_BUSINESS_HOURS is a display string: it is parsed into ISO 8601 for
# structured data, and an unparseable value is omitted rather than guessed at.
NEXT_PUBLIC_SERVICE_AREA=""

# -----------------------------------------------------------------------------
# Form notifications
# -----------------------------------------------------------------------------
# Where new service requests and contact messages are delivered.
CONTACT_NOTIFICATION_EMAIL="[inbox that should receive form submissions]"

# Email delivery for the notification above. Optional: if unset, submissions
# are stored in the database and logged, and no email is attempted.
RESEND_API_KEY=""

# -----------------------------------------------------------------------------
# Rate limiting (Upstash Redis REST — no SDK dependency required)
# -----------------------------------------------------------------------------
# Optional in local development: the limiter falls back to an in-memory
# window so the app runs with no external service. Production rate limiting
# across serverless instances REQUIRES these to be set.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# File uploads
# -----------------------------------------------------------------------------
# Directory for user-uploaded files. Intentionally outside `public/` so uploads
# are never served as static assets. NOTE: this filesystem is ephemeral on
# serverless hosts — see README "File storage" before going live.
UPLOAD_DIR="private-uploads"

# Maximum accepted upload size in megabytes. Keep this at or below 4 MB, which
# is the Vercel Server Action request body limit.
MAX_UPLOAD_MB="4"
