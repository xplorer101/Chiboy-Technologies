generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model contact_messages {
  id        String        @id
  fullName  String
  email     String
  phone     String?
  message   String
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime

  @@index([status, createdAt])
}

model job_tickets {
  id           String       @id
  reference    String       @unique
  title        String
  description  String
  status       TicketStatus @default(OPEN)
  assignedToId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  users        users?       @relation(fields: [assignedToId], references: [id])

  @@index([status, createdAt])
}

model portfolio_projects {
  id            String            @id
  slug          String            @unique
  title         String
  summary       String
  category      PortfolioCategory
  problem       String
  solution      String
  toolsUsed     String[]
  result        String
  coverImage    String
  images        String[]
  serviceSlug   String?
  isPlaceholder Boolean           @default(true)
  visibility    ProjectVisibility @default(PUBLISHED)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime

  @@index([category])
  @@index([visibility, sortOrder])
}

model service_categories {
  id               String             @id
  slug             String             @unique
  name             String
  description      String
  isActive         Boolean            @default(true)
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  service_requests service_requests[]

  @@index([isActive, sortOrder])
}

model service_request_attachments {
  id               String           @id
  requestId        String
  originalName     String
  storedName       String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime         @default(now())
  service_requests service_requests @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model service_requests {
  id                          String                        @id
  reference                   String                        @unique
  fullName                    String
  email                       String
  phone                       String
  serviceId                   String?
  serviceOther                String?
  location                    String
  contactPref                 PreferredContact              @default(PHONE)
  description                 String
  status                      RequestStatus                 @default(NEW)
  internalNotes               String?
  assignedToId                String?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime
  service_request_attachments service_request_attachments[]
  users                       users?                        @relation(fields: [assignedToId], references: [id])
  service_categories          service_categories?           @relation(fields: [serviceId], references: [id])

  @@index([createdAt])
  @@index([serviceId])
  @@index([status, createdAt])
}

model users {
  id               String             @id
  email            String             @unique
  name             String?
  role             UserRole           @default(STAFF)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  job_tickets      job_tickets[]
  service_requests service_requests[]
}

enum MessageStatus {
  NEW
  READ
  RESPONDED
  ARCHIVED
}

enum PortfolioCategory {
  SOFTWARE
  NETWORKING
  COMPUTER_SERVICES
  GRAPHICS_DESIGN
  OTHER
}

enum PreferredContact {
  PHONE
  WHATSAPP
  EMAIL
}

enum ProjectVisibility {
  DRAFT
  PUBLISHED
}

enum RequestStatus {
  NEW
  IN_REVIEW
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  AWAITING_PARTS
  RESOLVED
  CLOSED
}

enum UserRole {
  ADMIN
  STAFF
}
