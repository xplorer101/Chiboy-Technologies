generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  role             UserRole         @default(STAFF)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assignedTickets  JobTicket[]      @relation("TicketAssignee")
  assignedRequests ServiceRequest[] @relation("RequestAssignee")

  @@map("users")
}

model ServiceCategory {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requests    ServiceRequest[]

  @@index([isActive, sortOrder])
  @@map("service_categories")
}

model ServiceRequest {
  id            String                     @id @default(cuid())
  reference     String                     @unique
  fullName      String
  email         String
  phone         String
  serviceId     String?
  /// Populated when the visitor selects "Other" instead of a listed service.
  serviceOther  String?
  location      String
  contactPref   PreferredContact           @default(PHONE)
  description   String
  status        RequestStatus              @default(NEW)
  /// Internal only. Must never be returned by any public-facing query.
  internalNotes String?
  assignedToId  String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  attachments   ServiceRequestAttachment[]
  assignedTo    User?                      @relation("RequestAssignee", fields: [assignedToId], references: [id])
  service       ServiceCategory?           @relation(fields: [serviceId], references: [id])

  @@index([status, createdAt])
  @@index([serviceId])
  @@index([createdAt])
  @@map("service_requests")
}

model ServiceRequestAttachment {
  id           String         @id @default(cuid())
  requestId    String
  originalName String
  storedName   String
  storageKey   String
  /// Detected from file signature bytes on the server, never from the client.
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime       @default(now())
  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("service_request_attachments")
}

model PortfolioProject {
  id            String            @id @default(cuid())
  slug          String            @unique
  title         String
  summary       String
  category      PortfolioCategory
  problem       String
  solution      String
  toolsUsed     String[]
  result        String
  coverImage    String
  images        String[]
  serviceSlug   String?
  /// True while the entry is sample content. The UI labels these clearly and
  /// they are removed as real projects are supplied.
  isPlaceholder Boolean           @default(true)
  visibility    ProjectVisibility @default(PUBLISHED)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([visibility, sortOrder])
  @@index([category])
  @@map("portfolio_projects")
}

model ContactMessage {
  id        String        @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  message   String
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

model JobTicket {
  id           String       @id @default(cuid())
  reference    String       @unique
  title        String
  description  String
  status       TicketStatus @default(OPEN)
  assignedToId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedTo   User?        @relation("TicketAssignee", fields: [assignedToId], references: [id])

  @@index([status, createdAt])
  @@map("job_tickets")
}

enum UserRole {
  ADMIN
  STAFF
}

enum RequestStatus {
  NEW
  IN_REVIEW
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PreferredContact {
  PHONE
  WHATSAPP
  EMAIL
}

enum PortfolioCategory {
  SOFTWARE
  NETWORKING
  COMPUTER_SERVICES
  GRAPHICS_DESIGN
  OTHER
}

enum ProjectVisibility {
  DRAFT
  PUBLISHED
}

enum MessageStatus {
  NEW
  READ
  RESPONDED
  ARCHIVED
}

enum TicketStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  AWAITING_PARTS
  RESOLVED
  CLOSED
}
