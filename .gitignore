# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# Prisma client is generated code. Regenerated by `prisma generate`, which runs
# automatically on postinstall and before every production build.
src/generated/

# Environment — NEVER commit real values
.env
.env.local
.env.*.local
!.env.example

# Uploaded files. User-supplied content must never enter git.
private-uploads/
uploads/

# Test / tooling caches
coverage/
.vitest/
.vscode/*
!.vscode/settings.json
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS cruft
.DS_Store
Thumbs.db

# Prisma local artefacts
prisma/*.db
prisma/*.db-journal
